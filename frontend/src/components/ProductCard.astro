---
import { API_URL } from "../lib/config";

const { item } = Astro.props;

const imageUrl = item.image_url?.startsWith("http") ? item.image_url : `${API_URL}${item.image_url}`;

const productData = encodeURIComponent( JSON.stringify(item) );
---


<article

    class="product-card group cursor-pointer flex flex-col animate-fade-in-up"

    data-product={productData}

    data-search={`${item.name ?? ""} ${item.code ?? ""} ${item.capacity_ml ?? ""} ${item.capacity_oz ?? ""}`}

>


    <div

        class="aspect-square bg-[#F2EFE9] mb-4 p-6 flex items-center justify-center relative overflow-hidden transition-colors duration-300 group-hover:bg-[#ECE8DF]"

    >


        <img

            src={imageUrl}

            loading="lazy"

            alt={item.name ?? ""}

            class="max-h-full max-w-full object-contain mix-blend-multiply group-hover:scale-105 transition-all duration-700 ease-out"

        >



        {
            item.is_stock &&
            (

                <span

                    class="absolute top-4 left-4 text-[9px] uppercase tracking-widest text-stone-500 font-semibold"

                >

                    {item.is_stock}

                </span>

            )
        }


    </div>



    <div class="space-y-1">


        <h3

            class="text-xs uppercase tracking-wider font-semibold text-stone-900 group-hover:text-stone-600 transition-colors"

        >

            {item.name ?? "-"}


        </h3>


    </div>



</article>