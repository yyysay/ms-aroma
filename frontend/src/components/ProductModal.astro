<div
    id="product-modal"
    class="hidden fixed inset-0 bg-stone-900/30 backdrop-blur-sm z-50 flex items-center justify-center p-4 md:p-8"
>


    <section
        class="bg-[#FAF8F5] max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl p-6 md:p-12 relative flex flex-col md:flex-row gap-8"
    >


        <button
            id="modal-close"
            type="button"
            class="absolute top-6 right-6 text-stone-400 hover:text-stone-900 text-xs tracking-widest uppercase"
        >
            CLOSE ✕
        </button>




        <div
            class="md:w-1/2 aspect-square bg-[#F2EFE9] p-8 flex items-center justify-center"
        >

            <img
                id="modal-image"
                src=""
                alt=""
                class="max-h-full max-w-full object-contain mix-blend-multiply"
            >

        </div>





        <div
            class="md:w-1/2 flex flex-col justify-between"
        >

            <div class="space-y-6">


                <div
                    class="flex items-end justify-between gap-4"
                >

                    <h2
                        id="modal-name"
                        class="text-xl text-stone-900 font-medium leading-snug"
                    >
                    </h2>



                    <span
                        id="modal-code"
                        class="inline-flex items-center bg-stone-100 text-stone-900 border border-stone-200 text-[10px] uppercase tracking-widest font-mono font-bold px-2 py-0.5 rounded whitespace-nowrap"
                    >
                    </span>

                </div>





                <div
                    class="border-t border-stone-200 py-4 text-xs"
                >


                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            供应商
                        </span>

                        <span id="modal-supplier">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            公司料号
                        </span>

                        <span id="modal-material-no">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            罐装容量
                        </span>

                        <span id="modal-capacity">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            盎司 / 英制
                        </span>

                        <span id="modal-capacity-oz">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            纤维棒规格
                        </span>

                        <span id="modal-fiber-spec">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">纤维棒根数</span>
                        <span id="modal-fiber-count"></span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            克重
                        </span>

                        <span id="modal-weight">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            挥发周期
                        </span>

                        <span id="modal-evaporation">
                        </span>
                    </div>



                    <div class="flex justify-between py-2 border-b border-stone-100">
                        <span class="text-stone-400">
                            牙口规格
                        </span>

                        <span id="modal-mouth">
                        </span>
                    </div>



                    <div class="flex justify-between py-2">
                        <span class="text-stone-400">
                            器皿规格
                        </span>

                        <span id="modal-size">
                        </span>
                    </div>


                </div>





                <div
                    id="modal-canton-box"
                    class="hidden text-xs bg-[#F2EFE9] p-3 text-stone-700"
                >

                    <span
                        class="text-stone-400 block text-[10px] uppercase tracking-wider mb-1"
                    >
                        广交会规格
                    </span>


                    <span id="modal-canton">
                    </span>

                </div>





                <div
                    id="modal-history-box"
                    class="hidden text-xs bg-blue-100 border border-blue-200 rounded-lg p-3 text-blue-800"
                >

                    <span
                        class="text-blue-500 block text-[10px] uppercase tracking-wider mb-1"
                    >
                        历史订单规格
                    </span>


                    <span id="modal-history">
                    </span>

                </div>


            </div>


        </div>


    </section>


</div>