<div
    id="product-modal"
    class="hidden fixed inset-0 bg-stone-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 md:p-8"
>

    <section
        class="bg-[#FAF8F5] max-w-5xl w-full max-h-[90vh] overflow-y-auto shadow-2xl rounded-xl p-6 md:p-12 relative flex flex-col md:flex-row gap-8 md:gap-12"
    >

        <button
            id="modal-close"
            type="button"
            class="absolute top-6 right-6 text-stone-400 hover:text-stone-900 text-sm tracking-widest uppercase transition-colors"
        >
            CLOSE ✕
        </button>

        <!-- 左侧图片区 (固定正方形比例，空间变大) -->
        <div class="md:w-1/2 aspect-square bg-[#F2EFE9] rounded p-8 flex items-center justify-center shrink-0">
            <img
                id="modal-image"
                src=""
                alt=""
                class="max-h-full max-w-full object-contain mix-blend-multiply"
            >
        </div>

        <!-- 右侧数据区 (保持弹性填充) -->
        <div class="md:w-1/2 flex flex-col">

            <!-- 标题与编号：字号同步放大撑起气场 -->
            <div class="flex items-end justify-between gap-4 mb-5 shrink-0">
                <h2 id="modal-name"
                    class="text-2xl text-stone-900 font-medium leading-snug"
                >
                </h2>
                <span id="modal-code"
                    class="inline-flex items-center bg-stone-100 text-stone-900 border border-stone-200 text-xs uppercase tracking-widest font-mono font-bold px-2 py-0.5 rounded whitespace-nowrap shrink-0"
                >
                </span>
            </div>

            <!-- 属性列表：基础字号从 text-xs 升级到 text-sm，阅读更舒服 -->
            <div class="border-t border-stone-200 text-sm flex-1 flex flex-col">

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">供应商</span>
                    <span id="modal-supplier" class="text-stone-900 font-medium"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">公司料号</span>
                    <span id="modal-material-no" class="text-stone-900 font-mono"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">罐装容量</span>
                    <span id="modal-capacity" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">盎司 / 英制</span>
                    <span id="modal-capacity-oz" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">纤维棒规格</span>
                    <span id="modal-fiber-spec" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">纤维棒根数</span>
                    <span id="modal-fiber-count" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">克重</span>
                    <span id="modal-weight" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">挥发周期</span>
                    <span id="modal-evaporation" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between border-b border-stone-100 py-1.5">
                    <span class="text-stone-500">牙口规格</span>
                    <span id="modal-mouth" class="text-stone-900"></span>
                </div>

                <div class="flex-1 flex items-center justify-between py-1.5">
                    <span class="text-stone-500">器皿规格</span>
                    <span id="modal-size" class="text-stone-900"></span>
                </div>

            </div>

            <!-- 广交会规格：字号同步微调 -->
            <div id="modal-canton-box" class="hidden shrink-0 text-sm bg-[#F2EFE9] p-4 rounded text-stone-800 mt-5">
                <span class="text-stone-500 block text-xs uppercase mb-1">广交会规格</span>
                <span id="modal-canton"></span>
            </div>

            <!-- 历史订单：字号同步微调 -->
            <div id="modal-history-box" class="hidden shrink-0 text-sm bg-blue-50 border border-blue-200 rounded p-4 text-blue-900 mt-4">
                <span class="text-blue-500 block text-xs uppercase mb-1">历史订单规格</span>
                <span id="modal-history"></span>
            </div>

        </div>

    </section>

</div>