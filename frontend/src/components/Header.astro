---
const { count = 0, updatedAt = "" } = Astro.props;
---

<header class="sticky top-0 z-40 px-3 pt-3 md:px-6 md:pt-4">
    <div class="relative mx-auto max-w-[1440px] overflow-hidden rounded-2xl border border-white/75 bg-white/55 shadow-[0_8px_32px_rgba(41,37,36,0.06),inset_0_1px_0_rgba(255,255,255,0.9)] backdrop-blur-2xl backdrop-saturate-150">
        <div class="pointer-events-none absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/45 to-transparent"></div>

        <div class="relative flex flex-col items-start justify-between gap-5 px-5 py-4 md:flex-row md:items-center md:px-7 md:py-5">
            <div class="shrink-0">
                <p class="mb-1 text-[8px] font-medium uppercase tracking-[0.2em] text-stone-400">Product archive</p>
                <h1 class="text-2xl font-normal tracking-[-0.04em] text-stone-900 md:text-3xl">香薰器皿</h1>
            </div>

            <div class="flex w-full flex-col-reverse gap-3 md:w-auto md:flex-row md:items-center md:gap-6">
                <div class="flex shrink-0 items-center gap-4 text-[9px] tracking-wide text-stone-400 md:text-[10px]">
                    <span>总量 <strong data-result-count class="font-medium text-stone-900">{count}</strong></span>
                    {updatedAt && <span>更新 <strong class="font-medium text-stone-900">{updatedAt}</strong></span>}
                </div>

                <label class="relative block w-full md:w-72 lg:w-80">
                    <span class="sr-only">搜索产品</span>
                    <input
                        id="search-input"
                        class="product-search h-10 w-full rounded-xl border border-white/80 bg-white/45 px-4 pr-10 text-xs text-stone-800 shadow-[inset_0_1px_2px_rgba(41,37,36,0.04)] outline-none ring-1 ring-stone-200/50 transition-[background-color,box-shadow] placeholder:text-stone-400 hover:bg-white/60 focus:bg-white/80 focus:ring-stone-300"
                        type="search"
                        placeholder="搜索名称或编码"
                        autocomplete="off"
                    />
                    <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-base text-stone-400" aria-hidden="true">⌕</span>
                </label>
            </div>
        </div>
    </div>
</header>
