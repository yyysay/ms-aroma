---
const { count = 0, updatedAt = "" } = Astro.props;
---

<header class="sticky top-0 z-50 bg-[#faf9f6]/95 backdrop-blur-sm border-b border-stone-200/70">

    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-6">

        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
            
            <!-- Title -->
            <div>
                <h1 class="text-3xl md:text-5xl text-stone-900 tracking-tight font-normal">
                    香薰器皿图册
                    <span class="italic text-stone-300 text-2xl md:text-4xl ml-2">Collection</span>
                </h1>
            </div>

            <!-- Right tools -->
            <div class="flex flex-col md:items-end gap-4 w-full md:w-auto">

                <!-- Stats -->
                <div class="flex flex-col md:flex-row items-start md:items-center gap-4">

                    <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.05em] text-stone-400">
                        <span>总量:</span>
                        <span class="text-stone-900 font-semibold">{count}</span>
                    </div>

                    {
                        updatedAt &&
                        (
                            <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.05em] text-stone-400">
                                <span>最后更新时间:</span>
                                <span class="text-stone-900 font-semibold">{updatedAt}</span>
                            </div>
                        )
                    }

                </div>

                <!-- Search -->
                <div class="relative w-full md:w-80" >
                    <input
                        id="search-input"
                        type="text"
                        placeholder="搜索容量 / 编码 ..."
                        class="w-full bg-white/80 border border-stone-200 rounded-lg px-4 py-2.5 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:border-stone-400 transition-all"
                    />
                </div>

            </div>
        </div>
    </div>
</header>